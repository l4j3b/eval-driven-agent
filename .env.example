# Copy to .env.local and fill in.

# One key for every model (chat, embeddings, rerank): https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# Self-hosted Langfuse (npm run langfuse:up). The keys are the
# LANGFUSE_INIT_PROJECT_* values from langfuse/.env.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# The agent_app role through Supabase's session pooler (see db/bootstrap.sql).
DATABASE_URL=postgresql://agent_app.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Signs tool approval requests so a client can't forge or edit them.
# Generate with: openssl rand -base64 32
TOOL_APPROVAL_SECRET=
