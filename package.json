{
  "name": "eval-driven-agent",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:password": "tsx scripts/db-password.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:reset-activity": "tsx --env-file=.env.local scripts/reset-activity.ts",
    "data:generate": "tsx --env-file=.env.local scripts/generate-data.ts",
    "index": "tsx --env-file=.env.local scripts/index-content.ts",
    "prompt:push": "tsx --env-file=.env.local scripts/push-prompt.ts",
    "prompt:seed": "tsx --env-file=.env.local scripts/seed-prompts.ts",
    "seed:export": "tsx --env-file=.env.local scripts/export-seed.ts",
    "eval:seed": "tsx --env-file=.env.local scripts/seed-evals.ts",
    "eval": "tsx --env-file=.env.local scripts/run-evals.ts",
    "improve": "tsx --env-file=.env.local scripts/improve.ts",
    "langfuse:env": "tsx scripts/langfuse-env.ts",
    "langfuse:up": "docker compose -f langfuse/docker-compose.yml --env-file langfuse/.env up -d",
    "langfuse:down": "docker compose -f langfuse/docker-compose.yml --env-file langfuse/.env down"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.129",
    "@langfuse/client": "^6.0.0",
    "@langfuse/otel": "^6.0.0",
    "@langfuse/tracing": "^6.0.0",
    "@langfuse/vercel-ai-sdk": "^6.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "ai": "^7.0.126",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.577.0",
    "motion": "^13.4.6",
    "nanoid": "^6.0.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
